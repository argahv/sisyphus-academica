# Sisyphus Academica: configuration
# Copy to .env (or run `sisyphus configure`). Every value is optional.
# The sisyphus CLI loads this file; variables already set in the environment win.

# === LITERATURE SEARCH APIs ===

# Semantic Scholar API key (free). Without it, requests share the public rate limit.
# Get one: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Email for the CrossRef and OpenAlex polite pools (faster, more reliable responses)
CROSSREF_EMAIL=

# === VENUE ===

# Template used by `sisyphus new` and `sisyphus build`: arxiv, neurips, icml, iclr, nature
DEFAULT_VENUE=arxiv

# === VOICE ===

# Writing samples for voice calibration: a .txt file, or a directory of .txt/.md files.
# Relative paths resolve from the repository root. `sisyphus voice` builds the profile.
VOICE_SAMPLE_PATH=data/voice-profile

# === LLM PROVIDER (optional override) ===

# Models come from config/agent-config.json (provider/model strings, for example
# anthropic/claude-sonnet-4 or openai/gpt-4o). Set this to give every agent the same
# model when install.sh renders the agents.
# LLM_PROVIDER=anthropic/claude-sonnet-4
